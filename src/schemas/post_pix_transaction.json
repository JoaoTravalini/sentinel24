{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "amount", "transaction_date",
    "source_account", "destination_account", "source"
  ],
  "properties": {
    "id": {"$ref": "#/definitions/identifier"},
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transaction_date": {"$ref": "#/definitions/timestamp"},
    "source_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "account_number", "opening_date", "owner"],
      "properties": {
        "branch": {"$ref": "#/definitions/identifier"},
        "account_number": {"$ref": "#/definitions/identifier"},
        "opening_date": {"$ref": "#/definitions/timestamp"},
        "owner": {"$ref": "#/definitions/owner"}
      }
    },
    "destination_account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant", "branch", "account_number", "opening_date", "owner"
      ],
      "properties": {
        "participant": {"type": "string", "pattern": "^[0-9]{8}$"},
        "branch": {"$ref": "#/definitions/identifier"},
        "account_number": {"$ref": "#/definitions/identifier"},
        "opening_date": {"$ref": "#/definitions/timestamp"},
        "owner": {"$ref": "#/definitions/owner"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "channel", "ip"],
      "properties": {
        "device_id": {"$ref": "#/definitions/identifier"},
        "channel": {
          "type": "string", "minLength": 1,
          "maxLength": 32, "pattern": "\\S"
        },
        "ip": {"type": "string", "minLength": 1, "maxLength": 45},
        "geolocation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180}
          }
        }
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string", "minLength": 1,
      "maxLength": 128, "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_number"],
      "properties": {
        "document_number": {
          "type": "string", "minLength": 11, "maxLength": 32
        }
      }
    }
  }
}